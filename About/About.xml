      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
    </li>
    <li>
      <packageId>CETeam.CombatExtended</packageId>
      <displayName>Combat Extended</displayName>
    </li>
    <li>
      <packageId>Peren.IsoRim17</packageId>
      <displayName>IsoRim Waylith</displayName>
    </li>
    <li>
      <packageId>Peren.IsoRimProjectZ</packageId>
      <displayName>IsoRimZ</displayName>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>CETeam.CombatExtended</li>
    <li>Peren.IsoRim17</li>
    <li>Peren.IsoRimProjectZ</li>
  </loadAfter>
</ModMetaData>
